# Copy to .env.local for local development: cp .env.example .env.local

# Required for sign-in. Signs Auth.js cookies and hashes magic-link tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Optional locally. Without it, `next dev` uses an embedded Postgres (PGlite)
# under .data/pglite. Required on Vercel; the Neon integration supplies it.
DATABASE_URL=

# Optional locally. When omitted, `next dev` prints sign-in links to the
# terminal. Both are required on Vercel.
RESEND_API_KEY=
EMAIL_FROM="AgentProof <onboarding@resend.dev>"

# Optional registration settings. These are the defaults.
AGENTPROOF_DIRECTORY_DOMAIN=id.agentproof.dev
AGENT_LIMIT_EMAIL_VERIFIED=5
AGENT_LIMIT_DOMAIN_VERIFIED=50
AGENT_REGISTRATIONS_PER_DAY=10

# Vercel Preview and Production require AUTH_SECRET, DATABASE_URL,
# RESEND_API_KEY, and EMAIL_FROM. Never commit their values.
