# Copy to .env.local for local development: cp .env.example .env.local

# Required for sign-in. Signs Auth.js cookies and hashes magic-link tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Nothing else is needed locally. `next dev` uses an embedded Postgres
# (PGlite) stored in .data/pglite and prints sign-in links to the terminal.
#
# Vercel: no variables are needed yet. Preview and production have no
# database or email provider, so sign-in shows "not configured". When a
# hosted Postgres and an email provider are chosen, AUTH_SECRET, a database
# URL, and the email provider's API key must be added in the Vercel project
# settings.
